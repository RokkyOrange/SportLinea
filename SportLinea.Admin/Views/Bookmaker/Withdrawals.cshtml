@model IList<WithdrawalRequest>
@{
    ViewData["Title"] = "Заявки на вывод";
}

<h1 class="page-title">Заявки на вывод (от @WithdrawRules.BookmakerApprovalThreshold.ToString("N0") ₽)</h1>

@if (!Model.Any())
{
    <div class="card-panel text-center">
        <p style="color: var(--color-text-muted)">Нет заявок, ожидающих подтверждения</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-dark-custom table-striped">
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Игрок</th>
                    <th>Email</th>
                    <th>Сумма</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@r.Player.FullName</td>
                        <td>@r.Player.Email</td>
                        <td style="color: var(--color-accent); font-weight: 700">@r.Amount.ToString("N2") ₽</td>
                        <td>
                            <form asp-action="ApproveWithdrawal" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="btn btn-sm btn-success">Подтвердить</button>
                            </form>
                            <form asp-action="RejectWithdrawal" method="post" class="d-inline ms-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Отклонить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index" class="btn btn-outline-light mt-3">← Назад</a>
