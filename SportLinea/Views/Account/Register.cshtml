@model RegisterViewModel
@using SportLinea.Models
@{
    ViewData["Title"] = "Регистрация";
}

<h1 class="page-title">Регистрация</h1>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card-panel">
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-validation mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-validation"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-validation"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-validation"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Patronymic" class="form-label"></label>
                    <input asp-for="Patronymic" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="CountryOfResidence" class="form-label"></label>
                    <select asp-for="CountryOfResidence" class="form-select">
                        <option value="@CountryOfResidence.USA">@CountryPolicy.GetDisplayName(CountryOfResidence.USA)</option>
                        <option value="@CountryOfResidence.Russia">@CountryPolicy.GetDisplayName(CountryOfResidence.Russia)</option>
                    </select>
                    <span asp-validation-for="CountryOfResidence" class="text-validation"></span>
                    <small class="form-text" style="color: var(--color-text-muted)">
                        Наши игровые автоматы доступны только для резидентов США.
                    </small>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-validation"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-validation"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Зарегистрироваться</button>
            </form>
            <p class="mt-3 text-center" style="color: var(--color-text-muted)">
                Уже есть аккаунт? <a asp-action="Login" style="color: var(--color-accent)">Войти</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
