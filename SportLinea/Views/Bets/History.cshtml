@model List<Bet>
@{
    ViewData["Title"] = "История ставок";
    var status = ViewBag.Status as BetStatus?;
    var from = ViewBag.From as string;
    var to = ViewBag.To as string;
}

<h1 class="page-title">История ставок</h1>

<div class="card-panel mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Статус</label>
            <select name="status" class="form-select">
                <option value="">Все</option>
                <option value="@BetStatus.Accepted" selected="@(status == BetStatus.Accepted)">Принята</option>
                <option value="@BetStatus.Won" selected="@(status == BetStatus.Won)">Выиграла</option>
                <option value="@BetStatus.Lost" selected="@(status == BetStatus.Lost)">Проиграла</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">С</label>
            <input type="date" name="from" class="form-control" value="@from" />
        </div>
        <div class="col-md-3">
            <label class="form-label">По</label>
            <input type="date" name="to" class="form-control" value="@to" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Фильтр</button>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="card-panel text-center">
        <p style="color: var(--color-text-muted)">Ставок не найдено</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-dark-custom table-striped">
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Событие</th>
                    <th>Ставка на</th>
                    <th>Коэф.</th>
                    <th>Сумма</th>
                    <th>Выигрыш</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.CreatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td>
                        <td>@b.SportEvent.Title</td>
                        <td><strong style="color: var(--color-accent)">@(string.IsNullOrEmpty(b.OutcomeDescription) ? b.Coefficient?.OutcomeDescription : b.OutcomeDescription)</strong></td>
                        <td>@b.CoefficientValue.ToString("F2")</td>
                        <td>@b.Amount.ToString("N2") ₽</td>
                        <td>@(b.Status == BetStatus.Won ? b.Winnings.ToString("N2") + " ₽" : "—")</td>
                        <td>
                            <span class="badge @(b.Status == BetStatus.Won ? "badge-won" : b.Status == BetStatus.Lost ? "badge-lost" : "badge-pending")">
                                @(b.Status == BetStatus.Accepted ? "Принята" : b.Status == BetStatus.Won ? "Выиграла" : "Проиграла")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
