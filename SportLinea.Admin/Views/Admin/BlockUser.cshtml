@model BlockStaffViewModel
@{
    ViewData["Title"] = "Блокировка букмекера";
}

<h1 class="page-title">Блокировка букмекера: @Model.UserName</h1>

<div class="card-panel">
    <form asp-action="BlockUser" method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="UserName" />
        <div asp-validation-summary="ModelOnly" class="text-validation mb-3"></div>
        <div class="mb-3">
            <label asp-for="BlockReason" class="form-label"></label>
            <textarea asp-for="BlockReason" class="form-control" rows="4" placeholder="Опишите причину блокировки — она будет показана при попытке входа"></textarea>
            <span asp-validation-for="BlockReason" class="text-validation"></span>
        </div>
        <button type="submit" class="btn btn-danger">Заблокировать</button>
        <a asp-action="Bookmakers" class="btn btn-outline-light">Отмена</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
