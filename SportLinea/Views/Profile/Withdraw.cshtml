@model WithdrawViewModel

@using SportLinea.Models

@{

    ViewData["Title"] = "Вывод средств";

    var balance = (decimal)(ViewBag.Balance ?? 0m);

    var canWithdraw = balance >= WithdrawRules.MinAmount;

    var amountValue = Model.Amount > 0

        ? Model.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)

        : string.Empty;

}



<h1 class="page-title">Вывод средств</h1>



<div class="row justify-content-center">

    <div class="col-md-5">

        <div class="card-panel wallet-form-panel">

            <div class="wallet-form-header mb-4">

                <span class="wallet-form-label">Доступно к выводу</span>

                <div class="balance-display mb-0">@balance.ToString("N2") ₽</div>

                <p class="mb-0 mt-2" style="color: var(--color-text-muted); font-size: 0.875rem">

                    Минимальная сумма — @WithdrawRules.MinAmount.ToString("N0") ₽.

                </p>

            </div>



            @if (!canWithdraw)

            {

                <div class="alert alert-danger mb-0">

                    На счёте недостаточно средств для вывода. Минимум — @WithdrawRules.MinAmount.ToString("N0") ₽.

                </div>

                <a asp-action="Index" class="btn btn-outline-light w-100 mt-3">Назад в кабинет</a>

            }

            else

            {

                <form asp-action="Withdraw" method="post" id="withdrawForm" novalidate>

                    <div asp-validation-summary="ModelOnly" class="text-validation mb-3"></div>

                    <div class="mb-3">

                        <label class="form-label" for="withdrawAmount">Сумма вывода</label>

                        <input type="text"

                               name="Amount"

                               id="withdrawAmount"

                               class="form-control form-control-lg"

                               inputmode="decimal"

                               autocomplete="off"

                               value="@amountValue" />

                        <span class="text-validation" id="withdrawAmountError"></span>

                        @if (ViewData.ModelState["Amount"]?.Errors.Count > 0)

                        {

                            <span class="text-validation d-block">@ViewData.ModelState["Amount"]!.Errors[0].ErrorMessage</span>

                        }

                    </div>

                    <div class="withdraw-quick-amounts mb-4">

                        <button type="button" class="withdraw-chip" data-amount="2000">2 000 ₽</button>

                        <button type="button" class="withdraw-chip" data-amount="5000">5 000 ₽</button>

                        <button type="button" class="withdraw-chip" data-amount="10000">10 000 ₽</button>

                        <button type="button" class="withdraw-chip withdraw-chip-all" data-amount="@balance.ToString(System.Globalization.CultureInfo.InvariantCulture)">Всё</button>

                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-lg">Вывести средства</button>

                </form>

                <a asp-action="Index" class="btn btn-outline-light w-100 mt-2">Отмена</a>

            }

        </div>

    </div>

</div>



@if (canWithdraw)

{

    @section Scripts {

        <script>

            (function () {

                const form = document.getElementById('withdrawForm');

                const input = document.getElementById('withdrawAmount');

                const errorEl = document.getElementById('withdrawAmountError');

                const minAmount = @WithdrawRules.MinAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);

                const maxAmount = @balance.ToString(System.Globalization.CultureInfo.InvariantCulture);

                const minLabel = minAmount.toLocaleString('ru-RU');

                const maxLabel = maxAmount.toLocaleString('ru-RU', { minimumFractionDigits: 0, maximumFractionDigits: 2 });



                function parseAmount(raw) {

                    const normalized = raw.trim().replace(/\s/g, '').replace(',', '.');

                    if (!normalized) return null;

                    const value = Number(normalized);

                    return Number.isFinite(value) ? value : null;

                }



                function showError(message) {

                    errorEl.textContent = message;

                    input.classList.add('is-invalid');

                }



                function clearError() {

                    errorEl.textContent = '';

                    input.classList.remove('is-invalid');

                }



                function validateAmount() {

                    const value = parseAmount(input.value);

                    if (value === null) {

                        showError('Укажите сумму вывода');

                        return false;

                    }

                    if (value <= 0) {

                        showError('Укажите корректную сумму');

                        return false;

                    }

                    if (value < minAmount) {

                        showError(`Минимальная сумма вывода — ${minLabel} ₽`);

                        return false;

                    }

                    if (value > maxAmount + 0.0001) {

                        showError(`Недостаточно средств. Доступно: ${maxLabel} ₽`);

                        return false;

                    }

                    clearError();

                    return true;

                }



                input.addEventListener('input', clearError);



                form.addEventListener('submit', (e) => {

                    if (!validateAmount()) {

                        e.preventDefault();

                        e.stopImmediatePropagation();

                    }

                }, true);



                document.querySelectorAll('.withdraw-chip').forEach(btn => {

                    btn.addEventListener('click', () => {

                        const amount = parseFloat(btn.dataset.amount);

                        input.value = String(Math.min(Math.max(amount, minAmount), maxAmount));

                        clearError();

                    });

                });

            })();

        </script>

    }

}


