@model List<ActionLog>
@{
    ViewData["Title"] = "Журнал действий";
}

<h1 class="page-title">Журнал действий</h1>

<div class="table-responsive">
    <table class="table table-dark-custom table-striped">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Пользователь</th>
                <th>Действие</th>
                <th>IP</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td>@(log.User?.Email ?? "—")</td>
                    <td>@log.Action</td>
                    <td>@(log.IpAddress ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-outline-light">← Назад</a>
