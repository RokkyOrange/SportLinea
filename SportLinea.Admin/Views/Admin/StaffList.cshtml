@model IList<ApplicationUser>
@{
    ViewData["Title"] = "Букмекеры";
}

<h1 class="page-title">@ViewData["Title"]</h1>

<div class="table-responsive">
    <table class="table table-dark-custom table-striped">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Email</th>
                <th>Дата регистрации</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@u.RegistrationDate.ToLocalTime().ToString("dd.MM.yyyy")</td>
                    <td>
                        <span class="badge @(u.Status == UserStatus.Active ? "badge-won" : "badge-lost")">
                            @(u.Status == UserStatus.Active ? "Активен" : "Заблокирован")
                        </span>
                        @if (u.Status == UserStatus.Blocked && !string.IsNullOrWhiteSpace(u.BlockReason))
                        {
                            <div style="color: var(--color-text-muted); font-size: 0.8rem; max-width: 220px; margin-top: 0.25rem">
                                @u.BlockReason
                            </div>
                        }
                    </td>
                    <td>
                        @if (u.Status == UserStatus.Active)
                        {
                            <a asp-action="BlockUser" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger">Заблокировать</a>
                        }
                        else
                        {
                            <form asp-action="UnblockUser" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-light">Разблокировать</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-outline-light">← Назад</a>
