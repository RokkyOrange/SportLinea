@model List<SportEvent>
@using SportLinea.Models
@{
    ViewData["Title"] = "Линия событий";
    var sports = ViewBag.Sports as List<string> ?? new();
    var categories = ViewBag.Categories as List<string> ?? new();
    var selected = ViewBag.SelectedSport as string;
    var selectedCategory = ViewBag.SelectedCategory as string;
    var isStaffLineView = ViewBag.IsStaffLineView as bool? ?? false;
    var showRefresh = ViewBag.ShowRefresh as bool? ?? true;
    var displayedCount = (int)(ViewBag.DisplayedCount ?? Model.Count);
    var totalActiveCount = (int)(ViewBag.TotalActiveCount ?? Model.Count);
    var availableEventCount = (int)(ViewBag.AvailableEventCount ?? Math.Min(Model.Count, LineRules.PlayerLineDisplayCount));
    var playerLineLimit = (int)(ViewBag.PlayerLineLimit ?? LineRules.PlayerLineDisplayCount);
    var crazyTimeAllowed = ViewBag.CrazyTimeAllowed as bool? ?? true;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0">Линия событий</h1>
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <span style="color: var(--color-text-muted); font-size: 0.9rem">
            @if (isStaffLineView)
            {
                <text>Активных: <strong style="color: var(--color-accent)">@totalActiveCount</strong></text>
            }
            else
            {
                <text>Доступных событий: <strong style="color: var(--color-accent)">@availableEventCount</strong></text>
            }
        </span>
        @if (showRefresh)
        {
            <partial name="_RefreshLineForm" />
        }
    </div>
</div>

@if (categories.Any())
{
    <div class="mb-3">
        <span class="me-2" style="color: var(--color-text-muted); font-size: 0.875rem">Категория:</span>
        <a asp-action="Index" asp-route-sport="@selected" class="btn btn-sm @(selectedCategory == null ? "btn-primary" : "btn-outline-light") me-1">Все</a>
        @foreach (var cat in categories)
        {
            <a asp-action="Index" asp-route-sport="@selected" asp-route-category="@cat"
               class="btn btn-sm @(selectedCategory == cat ? "btn-primary" : "btn-outline-light") me-1">@cat</a>
        }
    </div>
}

@if (sports.Any())
{
    <div class="mb-4">
        <span class="me-2" style="color: var(--color-text-muted); font-size: 0.875rem">Вид спорта:</span>
        <a asp-action="Index" asp-route-category="@selectedCategory" class="btn btn-sm @(selected == null ? "btn-primary" : "btn-outline-light") me-1">Все</a>
        @foreach (var sport in sports)
        {
            <a asp-action="Index" asp-route-sport="@sport" asp-route-category="@selectedCategory"
               class="btn btn-sm @(selected == sport ? "btn-primary" : "btn-outline-light") me-1">@sport</a>
        }
    </div>
}

@if (!Model.Any())
{
    <div class="card-panel text-center">
        <p class="mb-2" style="color: var(--color-text-muted)">
            @if (isStaffLineView)
            {
                <text>Нет активных событий. Нажмите «Обновить линию», чтобы снова открыть события для ставок.</text>
            }
            else if (totalActiveCount == 0)
            {
                <text>Все события сыграны. Букмекер должен обновить линию, после чего нажмите «Обновить линию».</text>
            }
            else if (!string.IsNullOrEmpty(selected) || !string.IsNullOrEmpty(selectedCategory))
            {
                <text>Нет событий по выбранному фильтру. Сбросьте фильтр или нажмите «Обновить линию».</text>
            }
            else
            {
                <text>Нажмите «Обновить линию», чтобы загрузить @playerLineLimit новых матчей.</text>
            }
            @if (crazyTimeAllowed && !isStaffLineView)
            {
                <text> Или перейдите на <a asp-controller="Home" asp-action="Index" style="color: var(--color-accent)">главную</a> — там доступны наши игровые автоматы!</text>
            }
        </p>
        @if (showRefresh)
        {
            <partial name="_RefreshLineForm" view-data='new ViewDataDictionary(ViewData) { { "ButtonClass", "btn btn-primary btn-lg" } }' />
        }
    </div>
}
else
{
    @foreach (var e in Model)
    {
        <partial name="_EventCard" model="e" />
    }
}
