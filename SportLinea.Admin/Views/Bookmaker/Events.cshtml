@model List<SportEvent>
@{
    ViewData["Title"] = "Управление событиями";
}

<h1 class="page-title">Спортивные события</h1>
<a asp-action="CreateEvent" class="btn btn-primary mb-3">+ Создать событие</a>

<div class="table-responsive">
    <table class="table table-dark-custom table-striped">
        <thead>
            <tr>
                <th>Спорт</th>
                <th>Название</th>
                <th>Дата</th>
                <th>Статус</th>
                <th>Ставок</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.SportType</td>
                    <td>@e.Title</td>
                    <td>@e.StartDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@e.Status</td>
                    <td>@e.Bets.Count</td>
                    <td>
                        <a asp-action="EditEvent" asp-route-id="@e.Id" class="btn btn-sm btn-outline-light">Изменить</a>
                        <a asp-action="Coefficients" asp-route-id="@e.Id" class="btn btn-sm btn-outline-light">Коэф.</a>
                        @if (e.Status == EventStatus.AcceptingBets)
                        {
                            <a asp-action="SetResult" asp-route-id="@e.Id" class="btn btn-sm btn-primary">Результат</a>
                        }
                        @if (!e.Bets.Any())
                        {
                            <form asp-action="DeleteEvent" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@e.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Удалить событие?')">Удалить</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-outline-light">← Назад</a>
