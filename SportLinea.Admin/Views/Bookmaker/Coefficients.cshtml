@model SportEvent
@{
    ViewData["Title"] = "Коэффициенты";
}

<h1 class="page-title">Коэффициенты: @Model.Title</h1>

@foreach (var c in Model.Coefficients)
{
    <div class="card-panel mb-2">
        <form asp-action="UpdateCoefficient" method="post" class="d-flex align-items-center gap-3 flex-wrap">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@c.Id" />
            <strong style="min-width: 200px">@c.OutcomeDescription</strong>
            <input type="number" name="value" value="@c.Value" class="form-control" style="width: 120px"
                   step="0.01" min="1.01" max="100" />
            <button type="submit" class="btn btn-primary btn-sm">Обновить</button>
        </form>
    </div>
}

<a asp-action="Events" class="btn btn-outline-light mt-3">← Назад</a>
