@model DepositViewModel
@using SportLinea.Models
@{
    ViewData["Title"] = "Пополнение счёта";
    var balance = (decimal)(ViewBag.Balance ?? 0m);
    var amountValue = Model.Amount > 0
        ? Model.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)
        : string.Empty;
}

<h1 class="page-title">Пополнение счёта</h1>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card-panel wallet-form-panel">
            <div class="wallet-form-header mb-4">
                <span class="wallet-form-label">Текущий баланс</span>
                <div class="balance-display mb-0">@balance.ToString("N2") ₽</div>
                <p class="mb-0 mt-2" style="color: var(--color-text-muted); font-size: 0.875rem">
                    Минимальная сумма пополнения — @DepositRules.MinAmount.ToString("N0") ₽.
                </p>
            </div>

            <form asp-action="Deposit" method="post" id="depositForm" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-validation mb-3"></div>
                <div class="mb-3">
                    <label class="form-label" for="depositAmount">Сумма пополнения</label>
                    <input type="text"
                           name="Amount"
                           id="depositAmount"
                           class="form-control form-control-lg"
                           inputmode="decimal"
                           autocomplete="off"
                           value="@amountValue" />
                    <span class="text-validation" id="depositAmountError"></span>
                    @if (ViewData.ModelState["Amount"]?.Errors.Count > 0)
                    {
                        <span class="text-validation d-block">@ViewData.ModelState["Amount"]!.Errors[0].ErrorMessage</span>
                    }
                </div>
                <div class="withdraw-quick-amounts mb-4">
                    <button type="button" class="withdraw-chip" data-amount="1000">1 000 ₽</button>
                    <button type="button" class="withdraw-chip" data-amount="5000">5 000 ₽</button>
                    <button type="button" class="withdraw-chip" data-amount="10000">10 000 ₽</button>
                    <button type="button" class="withdraw-chip" data-amount="50000">50 000 ₽</button>
                </div>
                <button type="submit" class="btn btn-primary w-100 btn-lg">Пополнить</button>
            </form>
            <a asp-action="Index" class="btn btn-outline-light w-100 mt-2">Назад</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('depositForm');
            const input = document.getElementById('depositAmount');
            const errorEl = document.getElementById('depositAmountError');
            const minAmount = @DepositRules.MinAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const minLabel = minAmount.toLocaleString('ru-RU');

            function parseAmount(raw) {
                const normalized = raw.trim().replace(/\s/g, '').replace(',', '.');
                if (!normalized) return null;
                const value = Number(normalized);
                return Number.isFinite(value) ? value : null;
            }

            function showError(message) {
                errorEl.textContent = message;
                input.classList.add('is-invalid');
            }

            function clearError() {
                errorEl.textContent = '';
                input.classList.remove('is-invalid');
            }

            function validateAmount() {
                const value = parseAmount(input.value);
                if (value === null) {
                    showError('Укажите сумму пополнения');
                    return false;
                }
                if (value < minAmount) {
                    showError(`Минимальная сумма пополнения — ${minLabel} ₽`);
                    return false;
                }
                clearError();
                return true;
            }

            input.addEventListener('input', clearError);

            form.addEventListener('submit', (e) => {
                if (!validateAmount()) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                }
            }, true);

            document.querySelectorAll('.withdraw-chip').forEach(btn => {
                btn.addEventListener('click', () => {
                    const amount = parseFloat(btn.dataset.amount);
                    input.value = String(Math.max(amount, minAmount));
                    clearError();
                });
            });
        })();
    </script>
}
