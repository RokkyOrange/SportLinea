@model ProfileEditViewModel
@using SportLinea.Models
@{    ViewData["Title"] = "Редактирование профиля";
}

<h1 class="page-title">Редактирование профиля</h1>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card-panel">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-validation mb-3"></div>
                <div class="mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-validation"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-validation"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Patronymic" class="form-label"></label>
                    <input asp-for="Patronymic" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="CountryOfResidence" class="form-label"></label>
                    <select asp-for="CountryOfResidence" class="form-select">
                        <option value="@CountryOfResidence.USA">@CountryPolicy.GetDisplayName(CountryOfResidence.USA)</option>
                        <option value="@CountryOfResidence.Russia">@CountryPolicy.GetDisplayName(CountryOfResidence.Russia)</option>
                    </select>
                    <span asp-validation-for="CountryOfResidence" class="text-validation"></span>
                    <small class="form-text" style="color: var(--color-text-muted)">
                        Наши игровые автоматы доступны только для резидентов США.
                    </small>
                </div>
                <hr style="border-color: var(--color-border)" />
                <p style="color: var(--color-text-muted)">Оставьте поля пустыми, если не хотите менять пароль</p>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a asp-action="Index" class="btn btn-outline-light">Отмена</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
