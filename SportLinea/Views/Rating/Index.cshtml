@model List<PlayerRatingViewModel>
@{
    ViewData["Title"] = "Рейтинг игроков";
}

<h1 class="page-title">Общий рейтинг игроков</h1>

@if (!Model.Any())
{
    <div class="card-panel text-center">
        <p style="color: var(--color-text-muted)">Рейтинг пока пуст</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-dark-custom table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Игрок</th>
                    <th>Побед</th>
                    <th>Поражений</th>
                    <th>Сумма выигрышей</th>
                </tr>
            </thead>
            <tbody>
                @{ var rank = 1; }
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@(rank++)</td>
                        <td>@p.PlayerName</td>
                        <td style="color: var(--color-success)">@p.Wins</td>
                        <td style="color: var(--color-danger)">@p.Losses</td>
                        <td style="color: var(--color-accent); font-weight: 600">@p.TotalWinnings.ToString("N2") ₽</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
