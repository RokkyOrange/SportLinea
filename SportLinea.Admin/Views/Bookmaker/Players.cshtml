@model IList<ApplicationUser>
@{
    ViewData["Title"] = "Управление игроками";
}

<h1 class="page-title">Игроки</h1>

<div class="table-responsive">
    <table class="table table-dark-custom table-striped">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Email</th>
                <th>Баланс</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.FullName</td>
                    <td>@p.Email</td>
                    <td>@p.Balance.ToString("N2") ₽</td>
                    <td>
                        <span class="badge @(p.Status == UserStatus.Active ? "badge-won" : "badge-lost")">
                            @(p.Status == UserStatus.Active ? "Активен" : "Заблокирован")
                        </span>
                        @if (p.Status == UserStatus.Blocked && !string.IsNullOrWhiteSpace(p.BlockReason))
                        {
                            <div style="color: var(--color-text-muted); font-size: 0.8rem; max-width: 220px; margin-top: 0.25rem">
                                @p.BlockReason
                            </div>
                        }
                    </td>
                    <td>
                        @if (p.Status == UserStatus.Active)
                        {
                            <a asp-action="BlockPlayer" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Заблокировать</a>
                        }
                        else
                        {
                            <form asp-action="UnblockPlayer" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-light">Разблокировать</button>
                            </form>
                            if (p.Balance > 0)
                            {
                                <form asp-action="ResetPlayerBalance" method="post" class="d-inline"
                                      onsubmit="return confirm('Обнулить счёт игрока @p.FullName? Текущий баланс: @p.Balance.ToString("N2") ₽');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Обнулить счёт</button>
                                </form>
                            }
                        }
                        <a asp-action="AssignBonus" asp-route-id="@p.Id" class="btn btn-sm btn-primary">Бонус</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-outline-light">← Назад</a>
