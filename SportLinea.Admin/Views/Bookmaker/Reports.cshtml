@model dynamic
@{
    ViewData["Title"] = "Отчёт по событиям";
}

<h1 class="page-title">Отчёт по событиям</h1>

<div class="table-responsive">
    <table class="table table-dark-custom table-striped">
        <thead>
            <tr>
                <th>Событие</th>
                <th>Спорт</th>
                <th>Дата</th>
                <th>Статус</th>
                <th>Ставок</th>
                <th>Объём ставок</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Event.Title</td>
                    <td>@item.Event.SportType</td>
                    <td>@item.Event.StartDate.ToString("dd.MM.yyyy")</td>
                    <td>@item.Event.Status</td>
                    <td>@item.BetsCount</td>
                    <td>@item.TotalAmount.ToString("N2") ₽</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-outline-light">← Назад</a>
