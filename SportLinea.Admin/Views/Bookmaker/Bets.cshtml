@model List<Bet>
@{
    ViewData["Title"] = "Реестр ставок";
}

<h1 class="page-title">Реестр всех ставок</h1>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-8">
        <input type="text" name="search" class="form-control" placeholder="Поиск по игроку или событию..." value="@ViewBag.Search" />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary w-100">Найти</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-dark-custom table-striped">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Игрок</th>
                <th>Событие</th>
                <th>Исход</th>
                <th>Сумма</th>
                <th>Статус</th>
                <th>Выигрыш</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.CreatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</td>
                    <td>@b.Player.FullName</td>
                    <td>@b.SportEvent.Title</td>
                    <td>@(string.IsNullOrEmpty(b.OutcomeDescription) ? b.Coefficient?.OutcomeDescription : b.OutcomeDescription)</td>
                    <td>@b.Amount.ToString("N2") ₽</td>
                    <td>@b.Status</td>
                    <td>@b.Winnings.ToString("N2") ₽</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-outline-light">← Назад</a>
