@model List<FileInfo>
@{
    ViewData["Title"] = "Резервные копии";
}

<h1 class="page-title">Резервные копии</h1>

@if (!Model.Any())
{
    <div class="card-panel text-center">
        <p style="color: var(--color-text-muted)">Резервных копий пока нет</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-dark-custom table-striped">
            <thead>
                <tr><th>Файл</th><th>Дата создания</th><th>Размер</th></tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.Name</td>
                        <td>@f.CreationTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(f.Length / 1024) КБ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index" class="btn btn-outline-light">← Назад</a>
