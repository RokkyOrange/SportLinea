@model List<SportEvent>
@{
    ViewData["Title"] = "Итоги матчей";
}

<h1 class="page-title">Итоги матчей</h1>

@if (!Model.Any())
{
    <div class="card-panel text-center">
        <p style="color: var(--color-text-muted)">Завершённых матчей пока нет</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-dark-custom table-striped">
            <thead>
                <tr>
                    <th>Вид спорта</th>
                    <th>Событие</th>
                    <th>Дата завершения</th>
                    <th>Результат</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><span class="event-sport">@e.SportType</span></td>
                        <td>@e.Title</td>
                        <td>@e.StartDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td><strong style="color: var(--color-accent)">@e.Result</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
